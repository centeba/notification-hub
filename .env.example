# ── Core ────────────────────────────────────────────────────────────────────
ENVIRONMENT=local

# User tokens are RS256, issued by your user-master. Point the hub at its public
# key: a JWKS URL (preferred, supports key rotation) or a static PEM key.
JWT_JWKS_URL=                         # e.g. https://user-master.example.com/.well-known/jwks.json
JWT_PUBLIC_KEY=                       # PEM; literal \n accepted
JWT_AUDIENCE=                         # enforced when set
JWT_ISSUER=                           # enforced when set

# Secrets (generate strong random values in production)
INTERNAL_API_KEY=change-me            # X-Internal-Key on service-to-service calls
WEBHOOK_SECRET=change-me              # HMAC signing/verification of webhooks
FIELD_ENCRYPTION_KEY=                 # encrypted columns; `openssl rand -hex 32`
LLM_ENCRYPTION_KEY=                   # stored LLM keys; Fernet: `openssl rand -base64 32 | tr '+/' '-_'`

# ── Database (Postgres) ──────────────────────────────────────────────────────
# Set DATABASE_URL to override the POSTGRES_* parts (preferred).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notification_hub
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=notification_hub

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# Optional cluster-wide rate limiting (vendored middleware no-ops when unset):
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/1

# ── Temporal (worker + workflows) ────────────────────────────────────────────
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=integration-hub
# TEMPORAL_API_KEY=

# ── LLM providers (consumed by smart-llm) ────────────────────────────────────
# Set the key(s) for whichever providers you use; rotation via *_API_KEYS.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ── Channel providers ────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# AWS_ACCESS_KEY_ID=            # SES / SNS via aiobotocore
# AWS_SECRET_ACCESS_KEY=

# ── CORS / frontend ──────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5174
FRONTEND_HOST=http://localhost:5174

# ── Observability (all opt-in; no-op when unset — provided by smart-llm) ──────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SENTRY_DSN=
# LOG_LEVEL=INFO
